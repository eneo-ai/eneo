# ============================================================================
# ENEO FRONTEND ENVIRONMENT CONFIGURATION - PRODUCTION DEPLOYMENT
# ============================================================================
# This template is for production Docker deployments using docker-compose.yml
# ============================================================================

# ----------------------------------------------------------------------------
# Backend Connection (REQUIRED)
# ----------------------------------------------------------------------------
# These URLs control how the frontend connects to the backend API.
#
# IMPORTANT: Replace "your-domain.com" with your actual domain!
#
# Example for domain "eneo.example.com":
#   ENEO_BACKEND_URL=https://eneo.example.com
#   ENEO_BACKEND_SERVER_URL=http://backend:8000
#   PUBLIC_ENEO_BACKEND_URL=https://eneo.example.com
#   ORIGIN=https://eneo.example.com
# ----------------------------------------------------------------------------

# Server-side backend URL (used by frontend SSR for API calls)
ENEO_BACKEND_URL=https://your-domain.com

# Internal backend URL (server-to-server within Docker network)
# This connects directly to the backend container, skipping Traefik (faster for SSR)
ENEO_BACKEND_SERVER_URL=http://backend:8000

# Client-side backend URL (used by browser for API calls)
# The PUBLIC_ prefix exposes this to the browser (SvelteKit convention)
PUBLIC_ENEO_BACKEND_URL=https://your-domain.com

# Public origin (used for cookies and CORS)
ORIGIN=https://your-domain.com

# ----------------------------------------------------------------------------
# Security (REQUIRED)
# ----------------------------------------------------------------------------
# Kept for parity with backend JWT_SECRET; the web app does not read it.
# Tokens are issued and verified by the backend only.
JWT_SECRET=

# ----------------------------------------------------------------------------
# Authentication Configuration
# ----------------------------------------------------------------------------
# Sign-in is configured in the backend (env_backend.env); the web app reads no
# OIDC_* or FEDERATION_* variables. FEDERATION_ENABLED there chooses where the
# identity provider's settings live: stored in Eneo (recommended for new
# installations) or the OIDC_* variables in the server configuration.
# ----------------------------------------------------------------------------

# PUBLIC_ORIGIN (REQUIRED for OIDC authentication)
# The externally-reachable URL where users access Eneo
# Must match the IdP redirect_uri configuration
PUBLIC_ORIGIN=https://your-domain.com

# ----------------------------------------------------------------------------
# DEPRECATED: MobilityGuard variables are no longer used.
# The web app warns at startup while MOBILITY_GUARD_AUTH or
# MOBILITYGUARD_CLIENT_ID is still set; the backend's OIDC_* settings replace them.
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# DEPRECATED: Zitadel sign-in, removed in the next release.
# ZITADEL_INSTANCE_URL and ZITADEL_PROJECT_CLIENT_ID still turn on a sign-in of
# its own for Zitadel, and the web app warns at startup while either is set.
# Register Zitadel in the backend's OIDC_* settings instead and remove both:
# https://docs.eneo.ai/guides/oidc-federation#migrate-from-the-zitadel-settings
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# UI Feature Flags (OPTIONAL)
# ----------------------------------------------------------------------------
# Enable optional UI features
# DEPRECATED: SHOW_TEMPLATES - Use admin settings panel to enable templates per-tenant
# SHOW_TEMPLATES=true
# SHOW_HELP_CENTER=false

# ----------------------------------------------------------------------------
# External Services (OPTIONAL)
# ----------------------------------------------------------------------------
# Feedback and support links
# FEEDBACK_FORM_URL=
# REQUEST_INTEGRATION_FORM_URL=
# HELP_CENTER_URL=
# SUPPORT_EMAIL=support@yourdomain.com
# SALES_EMAIL=sales@yourdomain.com

# ----------------------------------------------------------------------------
# Environment Settings
# ----------------------------------------------------------------------------
NODE_ENV=production
LOGLEVEL=INFO

# Optional invitation to the React beta served by FastAPI (restart to apply).
# Default is off. The destination must be a valid HTTP(S) URL.
SHOW_NEW_APP_BANNER=false
NEW_APP_URL=
