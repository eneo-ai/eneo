# Docker Compose reads this file before it reads service env_file entries.
# Copy it to .env, set mode 0600, and keep it out of source control.

# Exact Eneo-attested multi-platform digest from the release's IMAGE-DIGESTS.txt.
# There is deliberately no mutable tag fallback.
ENEO_SEAWEEDFS_IMAGE=

# One credential pair is shared by Eneo and the bundled private object store.
# Use independently generated high-entropy values; these examples are blank on purpose.
OBJECT_CONTENT_ACCESS_KEY_ID=
OBJECT_CONTENT_SECRET_ACCESS_KEY=

# Generate once with `uuidgen` and preserve it across upgrades and restores.
OBJECT_CONTENT_DEPLOYMENT_ID=

# Vendor-neutral S3-compatible endpoint settings. For an external endpoint,
# change the URL/TLS values and run the bundled service at scale zero.
OBJECT_CONTENT_ENDPOINT_URL=http://object-content:8333
# This is the SigV4 signing region, not the bundled volume's physical location.
# `local` is the bundled SeaweedFS signing scope. For an external endpoint, use
# the value required by its self-hosted or European operator.
OBJECT_CONTENT_REGION=local
OBJECT_CONTENT_BUCKET=eneo-object-content
OBJECT_CONTENT_ALLOW_INSECURE_HTTP=true

# Bundled reference-store capacity tuning. These do not limit Eneo uploads.
SEAWEEDFS_VOLUME_SIZE_LIMIT_MB=30000
SEAWEEDFS_GARBAGE_THRESHOLD=0.3
