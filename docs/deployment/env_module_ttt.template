# ============================================================================
# TAL TILL TEXT MODULE - per-module secrets and configuration
# ============================================================================
# Copy to env_module_ttt.env. See MODULES.md for how to mint the API key.
#
# SECURITY: everything in this file stays server-side in the module
# container. None of these values are ever sent to the browser.
#
# USER LOGIN: modules have no IdP configuration of their own. Users log in
# via their Eneo session (SSO handoff from the backend) - see MODULES.md.

# Published Flow selected after package import, review, and publication.
# A Flow ID alone is not sufficient: do not enable the module until the
# installed Eneo release exposes the Flow runtime contract required by the
# verified module image.
TAL_TILL_TEXT_FLOW_ID=flow_replace_me

# Scoped Eneo service key (sk_...) - mint per MODULES.md with the narrowest
# scope that covers the module's needs. Never expose it to browser code.
ENEO_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Session cookie signing secret (32+ chars): openssl rand -hex 32
SESSION_SECRET=
