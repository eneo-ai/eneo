[importlinter]
root_package = eneo
include_external_packages = False

[importlinter:contract:flows-engine-no-ai-builder]
# The HTTP adapter composes the Builder plugin. Other engine and API modules
# must not depend directly on the plugin.
name = Flows engine must not import AI Builder
type = forbidden
allow_indirect_imports = true
source_modules =
    eneo.flows.api
    eneo.flows.application
    eneo.flows.assistant_authoring_snapshot
    eneo.flows.assistant_execution_snapshot
    eneo.flows.citation_sidecar
    eneo.flows.domain
    eneo.flows.enums
    eneo.flows.execution_backend
    eneo.flows.flow_access_policy
    eneo.flows.flow_ai_builder_budget_settings
    eneo.flows.flow_api_error_code
    eneo.flows.flow_api_exceptions
    eneo.flows.flow_authoring_name
    eneo.flows.flow_authoring_runtime_input
    eneo.flows.flow_authoring_spec
    eneo.flows.flow_authoring_transcription
    eneo.flows.flow_authoring_variable_rewriting
    eneo.flows.flow_capability_manifest
    eneo.flows.flow_document_limits
    eneo.flows.flow_error_taxonomy
    eneo.flows.flow_evidence_policy
    eneo.flows.flow_input_limits
    eneo.flows.flow_metadata
    eneo.flows.flow_resource_bindings
    eneo.flows.flow_retention_policy
    eneo.flows.flow_review_expiry_policy
    eneo.flows.flow_review_policy
    eneo.flows.flow_run_contract_service
    eneo.flows.flow_run_dispatch_request
    eneo.flows.flow_run_error
    eneo.flows.flow_run_input_envelope
    eneo.flows.flow_run_input_payload
    eneo.flows.flow_run_payload_validation
    eneo.flows.flow_run_provenance
    eneo.flows.flow_run_redaction
    eneo.flows.flow_run_step_input_file
    eneo.flows.flow_run_step_inputs
    eneo.flows.flow_run_step_result_file
    eneo.flows.flow_runtime_file_integrity
    eneo.flows.flow_runtime_file_service
    eneo.flows.flow_runtime_policy
    eneo.flows.flow_runtime_upload_repo
    eneo.flows.flow_security_classification
    eneo.flows.flow_settings
    eneo.flows.flow_template_asset_repo
    eneo.flows.flow_template_asset_service
    eneo.flows.flow_validators
    eneo.flows.flow_validators_form
    eneo.flows.flow_validators_http
    eneo.flows.flow_validators_template
    eneo.flows.flow_variable_definitions
    eneo.flows.http_transport
    eneo.flows.infrastructure
    eneo.flows.input_binding_contract_rules
    eneo.flows.output_modes
    eneo.flows.output_processing
    eneo.flows.principal
    eneo.flows.published_definition
    eneo.flows.published_runtime
    eneo.flows.runtime
    eneo.flows.source_display
    eneo.flows.source_identity
    eneo.flows.step_chain_rules
    eneo.flows.step_lineage
    eneo.flows.template_reference_analyzer
    eneo.flows.transcription_config
    eneo.flows.type_policies
    eneo.flows.variable_resolver
forbidden_modules =
    eneo.flows.ai_builder
ignore_imports =
    eneo.flows.api.flow_ai_builder_router -> eneo.flows.ai_builder.*

[importlinter:contract:fcm-no-ai-builder]
# The Flow Capability Manifest is engine truth. Even though the broader
# `flows-engine-no-ai-builder` contract already lists `flow_capability_manifest`
# in its source modules, we pin this narrower rule on its own so that:
# (1) a regression produces an FCM-specific failure message, and
# (2) the invariant survives any future revision of Rule 1's source enumeration.
name = FCM must not import AI Builder
type = forbidden
source_modules =
    eneo.flows.flow_capability_manifest
forbidden_modules =
    eneo.flows.ai_builder

[importlinter:contract:flow-packages-application-no-ai-builder]
# Flow package application services may consume the shared Flow authoring
# contracts, but they must not depend on AI Builder orchestration or catalogs.
name = Flow package application must not import AI Builder
type = forbidden
allow_indirect_imports = true
source_modules =
    eneo.flow_packages.application
forbidden_modules =
    eneo.flows.ai_builder

[importlinter:contract:flow-packages-domain-no-ai-builder]
# Flow package domain owns portable package schemas and must not depend on
# AI Builder session, planning, or orchestration modules.
name = Flow package domain must not import AI Builder
type = forbidden
allow_indirect_imports = true
source_modules =
    eneo.flow_packages.domain
forbidden_modules =
    eneo.flows.ai_builder

[importlinter:contract:flow-packages-domain-no-infrastructure]
# Package schemas, checksums, and envelope invariants are the portable contract.
# Zip parsing/writing remains infrastructure and must not leak back into domain.
name = Flow package domain must not import infrastructure
type = forbidden
allow_indirect_imports = true
source_modules =
    eneo.flow_packages.domain
forbidden_modules =
    eneo.flow_packages.infrastructure

[importlinter:contract:flow-packages-infrastructure-no-ai-builder]
# Zip/package adapters may parse the portable authoring graph, but they must not
# couple package IO to AI Builder internals.
name = Flow package infrastructure must not import AI Builder
type = forbidden
allow_indirect_imports = true
source_modules =
    eneo.flow_packages.infrastructure
forbidden_modules =
    eneo.flows.ai_builder

[importlinter:contract:ai-builder-no-mcp]
# Flow AI Builder does not advertise, resolve, or execute MCP resources.
# Non-Flow MCP behavior remains owned by the standalone assistant/conversation
# subsystem and must not leak into Flow planning.
name = AI Builder must not import MCP
type = forbidden
allow_indirect_imports = true
source_modules =
    eneo.flows.ai_builder
forbidden_modules =
    eneo.mcp_servers

[importlinter:contract:flows-no-crawler]
# Flows and the crawler are separate owners of outbound network access: neither
# imports the other. The address classification they can share lives in
# eneo.main.destination_policy.
name = Flows must not import the crawler
type = forbidden
allow_indirect_imports = true
source_modules =
    eneo.flows
forbidden_modules =
    eneo.crawler

[importlinter:contract:crawler-no-flows]
# The other direction of the same boundary.
name = Crawler must not import flows
type = forbidden
allow_indirect_imports = true
source_modules =
    eneo.crawler
forbidden_modules =
    eneo.flows

[importlinter:contract:transcription-services-no-flows]
# Flow orchestration depends on transcription services, never the reverse.
# Direct imports only: the admin adapters use platform modules (users, the
# table registry) that themselves reach small Flow modules.
name = Transcription services must not import flows
type = forbidden
allow_indirect_imports = true
source_modules =
    eneo.transcription_services
forbidden_modules =
    eneo.flows

[importlinter:contract:transcription-service-client-no-flows]
# Admin connection checks and Flow execution share the native service client
# and its vocabulary; neither may reach Flow code, even indirectly.
name = Transcription service client must not reach flows
type = forbidden
source_modules =
    eneo.transcription_services.client
    eneo.transcription_services.models
forbidden_modules =
    eneo.flows

[importlinter:contract:flow-vocabulary-readers-no-orm]
# Vocabulary belongs to the flows enum owner; these readers do not need
# table declarations to decide which values are valid.
name = Flow vocabulary readers must not import ORM tables
type = forbidden
allow_indirect_imports = true
source_modules =
    eneo.flows.flow_validators
    eneo.flows.runtime.step_definition_parser
forbidden_modules =
    eneo.database.tables.flow_tables

[importlinter:contract:flows-infrastructure-no-runtime]
# Persistence consumes domain delivery intents; runtime result envelopes
# belong to execution callers.
name = Flows infrastructure must not import runtime
type = forbidden
allow_indirect_imports = true
source_modules =
    eneo.flows.infrastructure
forbidden_modules =
    eneo.flows.runtime

[importlinter:contract:flow-publication-no-docx-runtime]
# Template assets own byte inspection; publication consumes their typed names.
name = Flow publication must not inspect DOCX bytes directly
type = forbidden
allow_indirect_imports = true
source_modules =
    eneo.flows.application.flow_service
forbidden_modules =
    eneo.flows.runtime.docx_template_runtime
