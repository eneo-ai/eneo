[importlinter]
root_package = intric
include_external_packages = False

[importlinter:contract:flows-engine-no-ai-builder]
# The flows engine (everything under `intric.flows` except the AI Builder
# plugin itself) must not import from the AI Builder. This contract locks
# the boundary so no new direct imports from the engine into the plugin
# slip in.
name = Flows engine must not import AI Builder
type = forbidden
allow_indirect_imports = true
source_modules =
    intric.flows.api
    intric.flows.application
    intric.flows.assistant_authoring_snapshot
    intric.flows.assistant_execution_snapshot
    intric.flows.citation_sidecar
    intric.flows.domain
    intric.flows.enums
    intric.flows.execution_backend
    intric.flows.flow
    intric.flows.flow_access_policy
    intric.flows.flow_authoring_name
    intric.flows.flow_authoring_runtime_input
    intric.flows.flow_authoring_spec
    intric.flows.flow_authoring_transcription
    intric.flows.flow_authoring_variable_rewriting
    intric.flows.flow_ai_builder_budget_settings
    intric.flows.flow_capability_manifest
    intric.flows.flow_care_data_policy
    intric.flows.flow_document_limits
    intric.flows.flow_evidence_policy
    intric.flows.flow_factory
    intric.flows.flow_file_upload_service
    intric.flows.flow_input_limits
    intric.flows.flow_metadata
    intric.flows.flow_permissions
    intric.flows.flow_review_policy
    intric.flows.flow_review_expiry_policy
    intric.flows.flow_resource_bindings
    intric.flows.flow_retention_policy
    intric.flows.flow_retention_tombstone
    intric.flows.flow_run_contract_models
    intric.flows.flow_run_contract_service
    intric.flows.flow_run_dispatch_request
    intric.flows.flow_run_error
    intric.flows.flow_run_evidence
    intric.flows.flow_run_evidence_bundle
    intric.flows.flow_run_evidence_export_summary
    intric.flows.flow_run_evidence_export_manifest
    intric.flows.flow_run_export_json
    intric.flows.flow_run_input_payload
    intric.flows.flow_run_payload_validation
    intric.flows.flow_run_provenance
    intric.flows.flow_run_redaction
    intric.flows.flow_run_rerun_graph
    intric.flows.flow_run_rerun_request
    intric.flows.flow_run_step_inputs
    intric.flows.flow_run_step_result_file
    intric.flows.flow_runtime_policy
    intric.flows.flow_security_classification
    intric.flows.flow_template_asset_repo
    intric.flows.flow_template_asset_service
    intric.flows.flow_template_validation
    intric.flows.flow_validators
    intric.flows.flow_validators_form
    intric.flows.flow_validators_http
    intric.flows.flow_validators_template
    intric.flows.flow_variable_definitions
    intric.flows.http_transport
    intric.flows.infrastructure
    intric.flows.input_binding_contract_rules
    intric.flows.output_modes
    intric.flows.output_processing
    intric.flows.principal
    intric.flows.published_definition
    intric.flows.runtime
    intric.flows.runtime_input
    intric.flows.source_display
    intric.flows.step_chain_rules
    intric.flows.step_config_secrets
    intric.flows.step_lineage
    intric.flows.template_reference_analyzer
    intric.flows.transcription_config
    intric.flows.type_policies
    intric.flows.variable_resolver
forbidden_modules =
    intric.flows.ai_builder
ignore_imports =
    intric.flows.api.flow_router -> intric.flows.ai_builder.ai_builder_router

[importlinter:contract:fcm-no-ai-builder]
# The Flow Capability Manifest is engine truth. Even though the broader
# `flows-engine-no-ai-builder` contract already lists `flow_capability_manifest`
# in its source modules, we pin this narrower rule on its own so that:
# (1) a regression produces an FCM-specific failure message, and
# (2) the invariant survives any future revision of Rule 1's source enumeration.
name = FCM must not import AI Builder
type = forbidden
source_modules =
    intric.flows.flow_capability_manifest
forbidden_modules =
    intric.flows.ai_builder

[importlinter:contract:flow-packages-application-no-ai-builder]
# Flow package application services may consume the shared Flow authoring
# contracts, but they must not depend on AI Builder orchestration or catalogs.
name = Flow package application must not import AI Builder
type = forbidden
allow_indirect_imports = true
source_modules =
    intric.flow_packages.application
forbidden_modules =
    intric.flows.ai_builder

[importlinter:contract:flow-packages-domain-no-ai-builder]
# Flow package domain owns portable package schemas and must not depend on
# AI Builder session, planning, or orchestration modules.
name = Flow package domain must not import AI Builder
type = forbidden
allow_indirect_imports = true
source_modules =
    intric.flow_packages.domain
forbidden_modules =
    intric.flows.ai_builder

[importlinter:contract:flow-packages-domain-no-infrastructure]
# Package schemas, checksums, and envelope invariants are the portable contract.
# Zip parsing/writing remains infrastructure and must not leak back into domain.
name = Flow package domain must not import infrastructure
type = forbidden
allow_indirect_imports = true
source_modules =
    intric.flow_packages.domain
forbidden_modules =
    intric.flow_packages.infrastructure

[importlinter:contract:flow-packages-infrastructure-no-ai-builder]
# Zip/package adapters may parse the portable authoring graph, but they must not
# couple package IO to AI Builder internals.
name = Flow package infrastructure must not import AI Builder
type = forbidden
allow_indirect_imports = true
source_modules =
    intric.flow_packages.infrastructure
forbidden_modules =
    intric.flows.ai_builder

[importlinter:contract:ai-builder-no-mcp-execution]
# AI Builder may read MCP server/tool metadata while planning, but it must not
# open MCP clients, proxy sessions, or admin/test connections. Runtime MCP tool
# execution belongs to the published Flow assistant/runtime path.
name = AI Builder must not import MCP execution surfaces
type = forbidden
allow_indirect_imports = true
source_modules =
    intric.flows.ai_builder
forbidden_modules =
    intric.mcp_servers.infrastructure.proxy
    intric.mcp_servers.infrastructure.client
    intric.mcp_servers.application.mcp_server_service
