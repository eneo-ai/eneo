    {"control": {"kind": "text", "tag": "omrade", "label": "Område", "hint": "Platsens beskrivning"}},
    {"paragraph": "Fastighet:"},
    {"control": {"kind": "text", "tag": "fastighetsbeteckning", "label": "Fastighet", "hint": "Fastighetsbeteckning"}},
    {"paragraph": "Ändamål:"},
    {"control": {"kind": "text", "tag": "andamal", "label": "Ändamål", "hint": "Vad marken får användas till"}},
    {"paragraph": "Upplåtelsetid från och med:"},
    {"control": {"kind": "text", "tag": "fran_och_med", "label": "Från och med", "hint": "Första dagen, inklusive uppbyggnad"}},
    {"paragraph": "Upplåtelsetid till och med:"},
    {"control": {"kind": "text", "tag": "till_och_med", "label": "Till och med", "hint": "Sista dagen, inklusive nedmontering"}},
