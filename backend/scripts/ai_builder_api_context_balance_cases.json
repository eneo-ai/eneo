    {
      "id": "exact_detail_legal_traceability",
      "complexity": "complex",
      "domain": "municipality_legal_transparency",
      "prompt": "Jag vill skapa ett flöde där jag laddar upp beslut, underlag och bilagor. Flödet ska ta fram en rapport som går att använda vid granskning: exakta centrala uppgifter ska bevaras, viktiga citat eller källhänvisningar ska tas med när de finns, osäkra uppgifter ska markeras, och det ska tydligt framgå vilken del av underlaget varje slutsats bygger på. Slutresultatet ska vara en PDF.",
      "expected": {
        "terminal_output_type": "pdf",
        "min_steps": 3,
        "min_json_steps": 1,
        "min_source_ref_steps": 1,
        "max_all_previous_steps": 1,
        "forbid_primary_material_form_fields": true,
        "forbid_generic_primary_reader_envelope": true,
        "expected_leaf_output_field_groups": [
          ["claim", "uppgift", "fact"],
          ["source", "källa", "kalla", "reference"],
          ["quote", "citat"],
          ["uncertainty", "osäkerhet", "osakerhet"],
          ["conclusion", "slutsats"]
        ]
      }
    },
    {
      "id": "underbuild_control_procurement_comparison",
      "complexity": "complex",
      "domain": "municipality_procurement",
      "prompt": "Jag vill bygga ett flöde för upphandlingsgranskning där jag laddar upp flera dokument: kravspecifikation, leverantörens anbudsutkast och kommunens inköpspolicy. Flödet måste jämföra dokumenten mot varandra, extrahera krav, leverantörslöften, avvikelser, risker, sekretesskänsliga delar och frågor till leverantören. Det ska skapa en strukturerad jämförelsematris och därefter en handläggarrapport i text.",
      "expected": {
        "terminal_output_type": "text",
        "min_steps": 4,
        "min_json_steps": 2,
        "min_source_ref_steps": 2,
        "max_all_previous_steps": 1,
        "forbid_primary_material_form_fields": true,
        "forbid_generic_primary_reader_envelope": true,
        "expected_leaf_output_field_groups": [
          ["requirements", "krav"],
          ["supplier_promises", "leverantörslöften", "leverantorsloften"],
          ["deviations", "avvikelser"],
          ["risks", "risker"],
          ["confidentiality", "sekretess"],
          ["questions", "frågor", "fragor"]
        ]
      }
    },
    {
      "id": "checklist_runtime_rule_field_or_question",
      "complexity": "medium",
      "domain": "municipality_permits",
      "prompt": "Jag vill bygga ett flöde för bygglovshandläggning. Vid körning laddar jag upp en ansökan och kan också ange vilken checklista eller regel som ska användas. Flödet ska läsa ansökan, jämföra mot checklistan, markera vilka krav som uppfylls, vilka som saknas, osäkra punkter och rekommenderad nästa åtgärd. Slutresultatet ska vara en tydlig rapport i text.",
      "expected": {
        "terminal_output_type": "text",
        "min_steps": 2,
        "min_json_steps": 1,
        "min_source_ref_steps": 1,
        "max_all_previous_steps": 1,
        "forbid_primary_material_form_fields": true,
        "expected_form_field_groups": [
          ["checklista", "checklist"],
          ["regel", "rule"]
        ],
        "expected_leaf_output_field_groups": [
          ["requirements", "krav"],
          ["status", "uppfylls"],
          ["missing", "saknas"],
          ["uncertainty", "osäkerhet", "osakerhet"],
          ["recommended_action", "rekommenderad_atgard", "nästa_åtgärd"]
        ]
      }
    }
  ]
