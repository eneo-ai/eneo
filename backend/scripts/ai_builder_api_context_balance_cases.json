{
  "version": 1,
  "description": "Focused Flow AI Builder evidence cases for source-context balance, runtime fields, structured questions, and under/over-building. These are review/evidence cases, not golden outputs.",
  "cases": [
    {
      "id": "document_pdf_source_retention_balance",
      "complexity": "medium",
      "domain": "municipality_records",
      "prompt": "Jag vill bygga ett flöde där jag kommer att skicka in en eller flera filer, vilket du kommer läsa innehållet och vad filen handlar om och baserat på det så kommer du att dokumentera ner vilken typ av dokument det är, vad den handlar om, kategori av dokument (sociologi, psykologi, IT m.m) och vad slutsatserna av dokumentet innebär samt datumet som dokumentet är skrivet och om möjligt av vem det är skrivet. Slutrapporten ska vara en pdf fil där det ska finnas titel på dokumentet, år, kategori osv och en koncis sammanfattning om vad den handlar om.",
      "expected": {
        "terminal_output_type": "pdf",
        "min_steps": 2,
        "min_json_steps": 1,
        "max_all_previous_steps": 1,
        "max_post_json_text_cleanup_steps": 1,
        "forbid_primary_material_form_fields": true,
        "forbid_generic_primary_reader_envelope": true,
        "expected_leaf_output_field_groups": [
          ["document_type", "dokumenttyp", "typ"],
          ["title", "titel", "document_title"],
          [
            "date_or_year",
            "year",
            "year_or_date",
            "datum",
            "år",
            "date",
            "document_date",
            "written_date",
            "date_written"
          ],
          [
            "author_or_sender",
            "author_or_source",
            "author",
            "sender",
            "författare",
            "avsändare"
          ],
          ["category", "kategori"],
          [
            "conclusions",
            "conclusion",
            "central_conclusions",
            "key_conclusions",
            "conclusion_summary",
            "conclusion_implication",
            "slutsatser"
          ],
          ["summary", "sammanfattning"]
        ]
      }
    },
    {
      "id": "runtime_fields_explicit_case_metadata",
      "complexity": "medium",
      "domain": "municipality_permits",
      "prompt": "Jag vill bygga ett flöde för bygglov. Vid körning laddar användaren upp ansökan och användaren ska också fylla i ärendenummer, kommun, handläggare och sista svarsdatum. Flödet ska läsa ansökan, sammanfatta ärendet, markera saknade uppgifter och skapa en kort handläggarrapport i text.",
      "expected": {
        "terminal_output_type": "text",
        "min_steps": 2,
        "min_json_steps": 1,
        "max_all_previous_steps": 1,
        "forbid_primary_material_form_fields": true,
        "expected_form_field_groups": [
          ["ärendenummer", "arendenummer", "case_number"],
          ["kommun", "municipality"],
          ["handläggare", "handlaggare", "case_worker"],
          ["sista_svarsdatum", "svarsdatum", "deadline", "due_date"]
        ],
        "expected_leaf_output_field_groups": [
          ["summary", "sammanfattning", "kort_sammanfattning", "arende_sammanfattning"],
          [
            "missing_information",
            "saknade_uppgifter",
            "saknade_eller_olika_uppgifter"
          ]
        ]
      }
    },
    {
      "id": "source_derived_report_fields_not_runtime_fields",
      "complexity": "simple",
      "domain": "municipality_records",
      "prompt": "Jag laddar upp ett dokument och vill att rapporten ska innehålla titel, år, dokumenttyp, kategori, avsändare, huvudbudskap och en kort sammanfattning. Användaren ska inte fylla i extra metadata; allt ska hämtas från dokumentet om det framgår.",
      "expected": {
