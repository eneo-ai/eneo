{
	"name": "Eneo Devcontainer",
	"dockerComposeFile": "docker-compose.yml",
	"service": "eneo",
	"workspaceFolder": "/workspace",
	// Docker publishes the dev server ports (docker-compose.yml), so they are
	// not in forwardPorts: VS Code's forwarder can leave a browser's requests
	// unanswered when a dev server restarts, and six of them block
	// localhost:<port> in that browser until it is restarted. Where the
	// published port is out of reach (Codespaces, a remote host), VS Code
	// still forwards a port it sees listening; "silent" keeps that from
	// raising a notification beside the published port.
	"portsAttributes": {
		"3000": { "label": "Frontend", "onAutoForward": "silent" },
		"3101": { "label": "React beta (apps/web-next, Vite)", "onAutoForward": "silent" },
		"8123": { "label": "Backend", "onAutoForward": "silent" }
	},
	"features": {
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
			"version": "latest",
			"moby": false
		},
		// Installs a prebuilt Node 22 (apps/web-next builds with Vite, which
		// requires Node 20.19+ or 22.12+). The feature reuses the base image's nvm at
		// /usr/local/share/nvm and adds node to containerEnv PATH, so the
		// remoteEnv PATH below picks it up. Avoids the source-compile fallback
		// that `nvm install 22` in post-create hit when the binary download failed.
		"ghcr.io/devcontainers/features/node:1": {
			"version": "22"
		}
	},
	"postCreateCommand": "bash .devcontainer/post-create.sh",
	"postStartCommand": "bash .devcontainer/post-start.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"charliermarsh.ruff",
				"svelte.svelte-vscode",
				"bradlc.vscode-tailwindcss"
			],
			"settings": {
				"python.defaultInterpreterPath": "/workspace/backend/.venv/bin/python",
				"python.pythonPath": "/workspace/backend/.venv/bin/python",
				"python.terminal.activateEnvironment": false,
				"[python]": {
					"editor.defaultFormatter": "charliermarsh.ruff"
				}
			}
		}
	},
	"remoteEnv": {
		"VIRTUAL_ENV": "/workspace/backend/.venv",
		"PATH": "/home/vscode/.bun/bin:/workspace/backend/.venv/bin:${containerEnv:PATH}"
	}
}
