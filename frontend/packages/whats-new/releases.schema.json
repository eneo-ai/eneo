{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eneo.ai/schemas/whats-new/releases.json",
  "title": "Eneo What's new releases",
  "description": "User-facing release notes. Newest release first. Validated by scripts/check_whats_new.py.",
  "type": "object",
  "required": ["releases"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "releases": {
      "type": "array",
      "items": { "$ref": "#/$defs/release" }
    }
  },
  "$defs": {
    "releaseVersion": {
      "type": "string",
      "description": "Semver without a leading v, matching the git tag (v2.2.0 -> 2.2.0).",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "localized": {
      "type": "object",
      "required": ["en", "sv"],
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "sv": { "type": "string", "minLength": 1 }
      }
    },
    "release": {
      "type": "object",
      "required": ["version", "entries"],
      "additionalProperties": false,
      "properties": {
        "version": {
          "description": "The release this block ships in, or \"next\" (develop only, undated, first) for merged changes that no final release includes yet. See PLAYBOOK.md.",
          "anyOf": [{ "$ref": "#/$defs/releaseVersion" }, { "const": "next" }]
        },
        "date": {
          "type": "string",
          "description": "Release date (YYYY-MM-DD). Leave out while the release is still a draft.",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/entry" }
        }
      }
    },
    "entry": {
      "type": "object",
      "required": ["id", "type", "area", "title", "body"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable kebab-case id, unique within the release. Used for deep links.",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "aliases": {
          "type": "array",
          "description": "Published ids merged into this entry. Kept as anchors, unique across all ids and aliases within the release.",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/entry/properties/id" }
        },
        "type": { "enum": ["new", "improved", "fixed"] },
        "area": {
          "enum": [
            "chat",
            "assistants",
            "knowledge",
            "spaces",
            "skills",
            "account",
            "admin",
            "platform"
          ]
        },
        "audience": {
          "enum": ["all", "admin"],
          "default": "all",
          "description": "admin entries are hidden from users without the admin permission."
        },
        "permissions": { "$ref": "#/$defs/permissions" },
        "title": { "$ref": "#/$defs/localized" },
        "body": { "$ref": "#/$defs/localized" },
        "showMe": {
          "type": "object",
          "description": "Optional 'Show me' action: navigate to href and spotlight the element with data-tour=anchor.",
          "required": ["href", "anchor"],
          "additionalProperties": false,
          "properties": {
            "href": {
              "type": "string",
              "description": "App-relative path without locale prefix.",
              "pattern": "^/[^\\s]*$"
            },
            "anchor": {
              "type": "string",
              "description": "Value of a data-tour attribute in frontend/apps/web/src.",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "description": "Additional effective user permissions: allOf AND anyOf. Admin does not bypass them. Omit for general news.",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "allOf": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/permission"
          }
        },
        "anyOf": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/permission"
          }
        }
      }
    },
    "permission": {
      "enum": [
        "assistants",
        "skills",
        "skills_management",
        "personal_skills",
        "personal_chat",
        "group_chats",
        "apps",
        "services",
        "collections",
        "insights",
        "AI",
        "editor",
        "admin",
        "websites",
        "integrations",
        "shared_spaces",
        "api_keys",
        "flows",
        "flows_view",
        "flows_run",
        "flows_manage",
        "flows_trace",
        "retention_manage",
        "retention_holds",
        "storage",
        "modules",
        "assistant_debug",
        "web_search",
        "image_generation",
        "file_analysis",
        "file_creation",
        "charts",
        "compute"
      ]
    }
  }
}
