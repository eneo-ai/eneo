{
  "name": "@eneo/ui",
  "sideEffects": false,
  "version": "1.22.0",
  "type": "module",
  "scripts": {
    "sync": "svelte-kit sync",
    "dev": "NODE_ENV=development svelte-kit sync && svelte-package --watch",
    "dev:app": "vite dev",
    "build:dev": "NODE_ENV=development svelte-kit sync && svelte-package",
    "build": "NODE_ENV=production svelte-kit sync && svelte-package && publint",
    "preview": "vite preview",
    "package": "NODE_ENV=production svelte-kit sync && svelte-package && publint",
    "prepare": "svelte-kit sync",
    "prepublishOnly": "npm run package",
    "test": "playwright test",
    "check": "NODE_ENV=production svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./components/markdown": {
      "types": "./dist/Markdown/index.d.ts",
      "svelte": "./dist/Markdown/index.js"
    },
    "./styles": "./src/styles/main.css",
    "./styles/prose": "./src/styles/prose.css",
    "./icons/vite-plugin-eneo-icons": "./src/icons/vite-plugin-eneo-icons.js",
    "./icons/types": {
      "types": "./src/icons/types.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "tailwind.config.js",
    "src/styles",
    "src/icons"
  ],
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@internationalized/date": "^3.12.2",
    "@eneo/eslint-plugin": "workspace:*",
    "@eneo/eneo-js": "workspace:*",
    "@melt-ui/svelte": "^0.86.5",
    "@playwright/test": "^1.61.1",
    "@sveltejs/adapter-auto": "^6.0.0",
    "@sveltejs/kit": "^2.68.0",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.3.2",
    "class-variance-authority": "^0.7.1",
    "echarts": "^5.6.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.62.1",
    "highlight.js": "^11.11.1",
    "marked": "^15.0.8",
    "prettier": "^3.9.4",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "publint": "^0.3.21",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "svelte-headless-table": "^0.18.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "uid": "^2.0.2",
    "vite": "^6.4.3"
  }
}
