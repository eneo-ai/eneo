{
  "name": "@eneo/ui",
  "sideEffects": false,
  "version": "1.22.0",
  "type": "module",
  "scripts": {
    "sync": "svelte-kit sync",
    "dev": "NODE_ENV=development svelte-kit sync && svelte-package --watch --preserve-output",
    "build:dev": "NODE_ENV=development svelte-kit sync && svelte-package",
    "build": "NODE_ENV=production svelte-kit sync && svelte-package && publint",
    "package": "NODE_ENV=production svelte-kit sync && svelte-package && publint",
    "prepare": "svelte-kit sync",
    "prepublishOnly": "npm run package",
    "check": "NODE_ENV=production svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "exports": {
    "./styles": "./src/styles/main.css",
    "./styles/prose": "./src/styles/prose.css",
    "./icons/vite-plugin-eneo-icons": "./src/icons/vite-plugin-eneo-icons.js",
    "./icons/types": {
      "types": "./src/icons/types.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "tailwind.config.js",
    "src/styles",
    "src/icons"
  ],
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@eneo/eslint-plugin": "workspace:*",
    "@sveltejs/adapter-auto": "^6.0.0",
    "@sveltejs/kit": "^2.68.0",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.3.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.62.1",
    "prettier": "^3.9.4",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "publint": "^0.3.21",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
