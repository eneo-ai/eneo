{
  "name": "@eneo/ui",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "svelte-kit sync && svelte-package --watch",
    "build": "svelte-kit sync && svelte-package && publint",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./src/lib/index.ts",
      "svelte": "./src/lib/index.ts"
    },
    "./styles": "./src/lib/styles/theme.css",
    "./utils": {
      "types": "./src/lib/utils/index.ts",
      "svelte": "./src/lib/utils/index.ts"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "src/lib/styles"
  ],
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.20.5",
    "@sveltejs/package": "^2.3.10",
    "bits-ui": "^2.16.3",
    "clsx": "^2.1.1",
    "publint": "^0.2.12",
    "svelte-check": "^4.1.6",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.3"
  },
  "svelte": "./src/lib/index.ts",
  "types": "./src/lib/index.ts"
}
