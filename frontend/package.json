{
  "version": "1.23.1",
  "private": true,
  "scripts": {
    "build": "NODE_ENV=production FORCE_COLOR=1 bun run --filter @eneo/ui build && NODE_ENV=production FORCE_COLOR=1 bun run --filter @eneo/web build",
    "dev": "bun scripts/frontend-dev.mjs start",
    "dev:status": "bun scripts/frontend-dev.mjs status",
    "dev:stop": "bun scripts/frontend-dev.mjs stop",
    "dev:restart": "bun scripts/frontend-dev.mjs restart",
    "dev:clean": "bun run clean:cache && bun run dev",
    "clean:cache": "rm -rf apps/web/node_modules/.vite apps/web/.svelte-kit packages/ui/.svelte-kit",
    "lint": "FORCE_COLOR=1 bun run --filter '*' lint",
    "check": "NODE_ENV=production FORCE_COLOR=1 bun run --filter '*' check",
    "format": "FORCE_COLOR=1 bun run --filter '*' format",
    "test": "bun run test:dev-lifecycle && cd apps/web && bun run test:unit",
    "test:dev-lifecycle": "bun test scripts/frontend-dev.test.mjs",
    "test:watch": "cd apps/web && bun run test:unit:watch",
    "test:e2e": "cd apps/web && bun run test:e2e",
    "test:e2e:ui": "cd apps/web && bun run test:e2e:ui",
    "test:e2e:report": "cd apps/web && bun run test:e2e:report",
    "test:all": "cd apps/web && bun run test:all",
    "knip": "knip-bun",
    "setup": "sh setup.sh",
    "setup:github": "GITHUB=TRUE sh setup.sh"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=18"
  },
  "resolutions": {
    "cookie": "0.7.2",
    "esbuild": ">0.25.0",
    "prettier": "3.9.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "knip": "^6.23.0",
    "prettier": "3.9.4",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.0"
  },
  "patchedDependencies": {
    "nextra-theme-docs@4.6.1": "patches/nextra-theme-docs@4.6.1.patch"
  }
}
