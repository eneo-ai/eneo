{
  "name": "@eneo/web-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "dev:clean": "bun run clean:cache && bun run dev",
    "clean:cache": "rm -rf .next node_modules/.cache",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/check-i18n.mjs && astryx theme build --check src/theme/eneo-theme.ts && prettier --check . && eslint",
    "format": "prettier --write .",
    "check": "next typegen && tsc --noEmit",
    "theme:build": "astryx theme build src/theme/eneo-theme.ts",
    "gen:api": "node scripts/gen-api.mjs",
    "i18n:convert": "node scripts/convert-paraglide-messages.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
