# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

/out/

# production
/build

# Vite build output and TanStack Router generator scratch
/dist
/.tanstack/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example


# typescript
*.tsbuildinfo

# Playwright
/playwright/.auth/
/test-results/
/test-results-fastapi/
/playwright-report/
/playwright-report-fastapi/
/blob-report/
