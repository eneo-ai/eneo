ENEO_BACKEND_URL=http://localhost:8123

# Required from Phase 2: encrypts the session cookie (min 32 chars)
# SESSION_SECRET=

# OIDC (enabled only when OIDC_ISSUER is set; otherwise password-login mode)
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# APP_ORIGIN=http://localhost:3100

# Feature flags
SHOW_WEB_SEARCH=false
# "Har du en fråga?" in the navigation: needs both the flag and the URL.
SHOW_HELP_CENTER=false
# HELP_CENTER_URL=
# REQUEST_INTEGRATION_FORM_URL=

# Accessibility statement (tillgänglighetsredogörelse), linked from the login
# page and the profile menu when set
# ACCESSIBILITY_STATEMENT_URL=

# Optional return link while both frontends run in parallel.
LEGACY_APP_URL=
