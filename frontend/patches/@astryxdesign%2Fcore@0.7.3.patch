diff --git a/dist/Layer/layerSlideRules.js b/dist/Layer/layerSlideRules.js
index 853597bf74d8f37bbb75418d2a8119575a91a975..7564aac55ab62ece2544fd4d3dbe092c2cb97a2b 100644
--- a/dist/Layer/layerSlideRules.js
+++ b/dist/Layer/layerSlideRules.js
@@ -104,6 +104,15 @@ export function ensureSlideRules(doc) {
   }
   const style = doc.createElement('style');
   style.id = SLIDE_RULES_ID;
+  // Eneo patch: a CSP that allows <style> only with a nonce blocks the sheet
+  // without one, and then no layer can slide or flip. Take the nonce of a
+  // script or style this document was served with (the app may set the
+  // bundler global only after the first layer mounts, and an iframe has its
+  // own), else the bundler global.
+  const nonce = doc.querySelector('script[nonce],style[nonce]')?.nonce || globalThis.__webpack_nonce__;
+  if (nonce) {
+    style.nonce = nonce;
+  }
   style.textContent = slideRulesCss();
   doc.head.appendChild(style);
 }
