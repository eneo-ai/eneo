{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "**/paraglide/**",
    "**/tests/**",
    "scripts/fixtures/**"
  ],
  "ignoreDependencies": [
    "@eneo/icons.*",
    "prettier",
    "prettier-plugin-.*"
  ],
  "ignoreWorkspaces": [
    "apps/docs-site"
  ],
  "rules": {
    "exports": "off",
    "nsExports": "off",
    "types": "off",
    "nsTypes": "off",
    "enumMembers": "off"
  },
  "workspaces": {
    "apps/web": {
      "entry": [
        "src/hooks.ts"
      ],
      "ignore": [
        "src/lib/paraglide/**",
        "plugins/fixtures/**"
      ]
    },
    "apps/web-next": {
      "entry": [
        "src/lib/i18n/request.ts",
        "src/theme/eneo-theme.ts",
        "scripts/*.mjs"
      ]
    },
    "packages/ui": {
      "entry": [
        "src/lib/index.ts"
      ],
      "ignore": [
        "src/icons/Icon.svelte"
      ]
    },
    "packages/eneo-js": {
      "ignoreDependencies": [
        "openapi-typescript"
      ]
    },
    "packages/eslint-plugin": {}
  }
}
